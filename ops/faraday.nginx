# faraday.openconverters.com — static SPA, WASM engine, no backend.
# Mirrors the Hertz vhost. Installed to /etc/nginx/sites-available/faraday
# and symlinked into sites-enabled by scripts/deploy.sh.
# TLS lines are added by certbot once the DNS A record exists.
server {
    server_name faraday.openconverters.com;

    access_log /var/log/faraday_web_access.log;
    error_log /var/log/faraday_web_error.log;

    charset utf-8;
    root    /opt/faraday/dist;
    index   index.html;

    gzip_static on;

    # Content-hashed build assets — safe to cache hard.
    location /assets/ {
        include /etc/nginx/snippets/oc-security-headers.conf;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The engine has a stable name: revalidate so redeploys reach returning visitors.
    location = /faraday.js {
        include /etc/nginx/snippets/oc-security-headers.conf;
        add_header Cache-Control "no-cache";
    }
    location = /faraday.wasm {
        include /etc/nginx/snippets/oc-security-headers.conf;
        add_header Cache-Control "no-cache";
        types { application/wasm wasm; }
    }

    # The parts inspector reads the Kelvin catalogue SAME-ORIGIN (the CSP allows
    # no other host): Kelvin's own deployed engine bundle, and the data set
    # (manifest + .kidx shards + the NDJSON catalogs the records are Range-read
    # from) off the shared /cache volume — the SAME self-consistent set
    # kelvin.openconverters.com and kirchhoff.openconverters.com serve. Not a
    # backend; static files. The engine must be the one the shards were built
    # for, which is why it is Kelvin's dist, never a copy kept here.
    location = /kelvin.js {
        include /etc/nginx/snippets/oc-security-headers.conf;
        root /opt/kelvin/dist;
        gzip_static on;
        add_header Cache-Control "no-cache";
    }
    location ~ ^/kelvin/.+\.kidx$ {
        include /etc/nginx/snippets/oc-security-headers.conf;
        root /cache;
        gzip_static on;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location /kelvin/ {
        include /etc/nginx/snippets/oc-security-headers.conf;
        root /cache;
        gzip_static on;
        add_header Cache-Control "no-cache";
    }

    # The part inspector's last resort: when the catalogue has never heard of a
    # part number, Heaviside's librarian sources it from the distributor and
    # stages it for the catalogue. Same-origin for the CSP's sake, exactly as
    # the Kelvin data above.
    #
    # EXACTLY ONE PATH, POST ONLY. Heaviside's API also carries job submission
    # (which burns LLM tokens) and a URL fetch (an SSRF surface); `location
    # /heaviside/` would publish all of it here. A prefix would have been less
    # typing and much worse.
    #
    # Rate-limited because each call spends a real Digi-Key API request against
    # our account. oc_librarian is defined in conf.d/oc-librarian-limit.conf.
    location = /heaviside/librarian/lookup {
        include /etc/nginx/snippets/oc-security-headers.conf;
        limit_except POST { deny all; }
        limit_req zone=oc_librarian burst=3 nodelay;
        proxy_pass http://127.0.0.1:8774/librarian/lookup;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # a distributor round-trip plus a schema validation; not instant
        proxy_read_timeout 60s;
        client_max_body_size 4k;
    }

    # Umami analytics — same-box OM instance, same-origin first-party tracker.
    location = /stats { return 308 /stats/; }
    location /stats/ {
        include /etc/nginx/snippets/oc-security-headers.conf;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        include /etc/nginx/snippets/oc-security-headers.conf;
        include /etc/nginx/snippets/oc-csp.conf;
        try_files $uri $uri/ /index.html;
    }

    listen 80;
}
